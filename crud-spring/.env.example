# Copy this file to `.env` and fill in the blank values.
# `.env` is ignored by git and must never be committed.

# MySQL, created by docker compose on first start
DB_USER=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Secret that signs the JWT tokens. Required: the application does not start without it.
# Any long random string works, for example the output of: openssl rand -base64 32
JWT_SECRET=
